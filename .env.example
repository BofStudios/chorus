# Chorus — developer credentials
#
# Copy this file to .env and fill in only the providers you intend to use.
# .env is gitignored. Never commit real values.
#
# Anything already set in the real environment wins over this file, so
# production can supply these as environment variables and ignore .env entirely.
#
# You can also paste these into the app: Settings → Integrations. They are then
# stored encrypted against your OS user account instead of sitting on disk.


# ─── Composio ────────────────────────────────────────────────────────────────
# One key reaches hundreds of platforms and Composio runs the OAuth, so you do
# not have to register a developer app per service. The trade: Composio stores
# the access tokens on its servers rather than on this machine.
#
# Get one: https://app.composio.dev  →  Settings  →  API Keys
COMPOSIO_API_KEY=


# ─── Direct connections ──────────────────────────────────────────────────────
# These keep the access token in this machine's encrypted vault. Each needs its
# own developer app, which is more setup for more control.


# X (Twitter) — https://developer.x.com/en/portal/dashboard
# Create a project and app, enable OAuth 2.0, set the app type to "Native App"
# so PKCE is used, and add the callback URL below.
# Callback: http://127.0.0.1:7801/oauth/callback/x
# Note: direct messages and search need a paid API tier. The free tier connects
# and reads your profile, and X refuses everything else.
X_CLIENT_ID=
X_CLIENT_SECRET=


# Meta / Instagram — https://developers.facebook.com/apps
# Requires an Instagram Professional (Business or Creator) account. Add the
# Instagram product, then add the callback URL below.
# Callback: http://127.0.0.1:7801/oauth/callback/instagram
# What works: publishing to your own feed, reading and replying to comments,
# and replying to people who messaged you first within 24 hours.
# What does not: messaging anyone who has not written to you, and user search.
META_APP_ID=
META_APP_SECRET=


# Reddit — https://www.reddit.com/prefs/apps
# Choose "installed app" (no client secret needed for that type).
# Callback: http://127.0.0.1:7801/oauth/callback/reddit
# What works: posting and commenting where your project is on topic, search,
# and a small number of private messages. Bulk PMs get accounts shadowbanned,
# so Chorus caps them at two an hour.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=


# Google / Gmail — https://console.cloud.google.com/apis/credentials
# Create an OAuth client ID of type "Desktop app", then enable the Gmail API.
# Callback: http://127.0.0.1:7801/oauth/callback/google
# gmail.send is a restricted scope: until your consent screen is verified, only
# accounts you add as test users can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# LinkedIn — https://www.linkedin.com/developers/apps
# Callback: http://127.0.0.1:7801/oauth/callback/linkedin
# Connects and identifies you. Messaging is limited to LinkedIn partners and is
# not available to general applications, so Chorus will not offer to send.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=


# ─── Development ─────────────────────────────────────────────────────────────
# Registers a clearly-labelled mock provider so the approval queue and sending
# pipeline can be exercised without live credentials. It never transmits.
# CHORUS_DEV_MOCK=1
