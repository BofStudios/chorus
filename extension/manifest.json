{
  "manifest_version": 3,
  "name": "Chorus Companion",
  "version": "0.1.0",
  "description": "Queue GitHub developers into the Chorus desktop app while you browse. One click, nothing automated.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:7801/*",
    "http://127.0.0.1:7802/*",
    "http://127.0.0.1:7803/*",
    "http://127.0.0.1:7804/*",
    "http://127.0.0.1:7805/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chorus Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
